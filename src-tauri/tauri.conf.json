{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Senritsu",
  "version": "0.2.0",
  "identifier": "app.senritsu.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Senritsu",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Music",
    "shortDescription": "Customizable, ad-free YouTube Music client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
